  "name": "Gated Retrieval",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "genx-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "nb1-webhook",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "webhookId": "genx-chat-webhook"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst bodyData = item.body || item;  // webhook nests JSON body under .body\nconst query = String(bodyData.query || bodyData.message || bodyData.text || '').trim();\nconst isGreeting = /^(hi|hello|hey|greetings|good\\s*(morning|afternoon|evening)|howdy)[^a-z]*$/i.test(query);\nreturn { json: { query, isGreeting } };"
      },
      "id": "nb2-router",
      "name": "Intent Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-greeting",
              "leftValue": "={{ $json.isGreeting }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nb3-is-greeting",
      "name": "Is Greeting?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ response: \"Hello! I'm Dr. Sara's AI coaching assistant. Ask me a question about leadership, team performance, executive presence, or delegation \u2014 and I'll answer in her voice.\" }) }}"
      },
      "id": "nb4-greet-response",
      "name": "Greeting Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        920,
        160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { query } = $input.item.json;\nreturn {\n  json: {\n    query,\n    requestBody: { model: 'bge-m3', input: query }\n  }\n};"
      },
      "id": "nb5-build-embed",
      "name": "Build Embed Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/embed",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "nb6-embed-query",
      "name": "Embed Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const embedResponse = $input.item.json;\nconst queryData = $(\"Build Embed Payload\").item.json;\n\nconst rawEmbedding = embedResponse.embeddings?.[0] || embedResponse.embedding || [];\nconst embeddingStr = '[' + rawEmbedding.join(',') + ']';\n\nconst selectSQL = 'SELECT content, stream_type, metadata::text AS meta, '\n  + '1 - (embedding <=> \\'' + embeddingStr + '\\'::vector) AS similarity '\n  + 'FROM knowledge_vault ORDER BY similarity DESC LIMIT 6';\n\nreturn { json: { query: queryData.query, selectSQL } };"
      },
      "id": "nb7-format-embedding",
      "name": "Format Embedding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.selectSQL }}",
        "additionalFields": {}
      },
      "credentials": {
        "postgres": {
          "id": "S9EGXoySbGWiJU8X",
          "name": "GenX PostgreSQL"
        }
      },
      "id": "nb8-search",
      "name": "Similarity Search",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1580,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all();\nconst queryNode = $(\"Format Embedding\").first().json;\nconst originalQuery = queryNode.query;\n\nconst FRAMEWORK_THRESHOLD = 0.49;\nconst VOICE_THRESHOLD = 0.47;\n\nconst validRows = rows.filter(r => {\n  const sim = parseFloat(r.json.similarity) || 0;\n  const st = r.json.stream_type;\n  if (st === 'framework') return sim >= FRAMEWORK_THRESHOLD;\n  if (st === 'voice_sample') return sim >= VOICE_THRESHOLD;\n  return false;\n});\n\nif (validRows.length === 0) {\n  return [{ json: { hasResults: false, response: 'No documented coaching frameworks match this topic.', originalQuery } }];\n}\n\nconst context = validRows\n  .map(r => '[' + r.json.stream_type.toUpperCase() + ']\\n' + r.json.content)\n  .join('\\n\\n---\\n\\n');\n\nreturn [{ json: { hasResults: true, context, originalQuery } }];"
      },
      "id": "nb9-circuit-breaker",
      "name": "Circuit Breaker",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-results",
              "leftValue": "={{ $json.hasResults }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "nb10-has-results",
      "name": "Has Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2020,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ response: $json.response }) }}"
      },
      "id": "nb11-no-match",
      "name": "No Match Fallback",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2240,
        160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { context, originalQuery } = $input.item.json;\n\nconst systemPrompt = `You are Dr. Sara Hegy, a no-nonsense executive coach known for systems-thinking and precision framing. You speak directly, never hedge, and always reframe the problem before solving it.\n\nHere are examples of how you respond:\n\nQ: My team is not hitting deadlines.\nA: Missed deadlines are rarely a motivation problem \u2014 they are a clarity problem. Before you pressure the team, audit the handoff: does everyone have the binary exit criteria for their deliverable? If not, you are running quality control through adrenaline, not architecture.\n\nQ: I am overwhelmed as a founder.\nA: That overwhelm is a signal, not a character flaw. When everything routes back to you, your system is bleeding signal. The fix is not working harder \u2014 it is rebuilding the information architecture so the right constraints catch problems before they reach your desk.\n\nNow answer the question below using only the retrieved coaching context. Mirror this directness and framework-first thinking.`;\n\nconst requestBody = {\n  model: 'llama3.2',\n  stream: false,\n  messages: [\n    { role: 'system', content: systemPrompt },\n    { role: 'user', content: `Retrieved coaching context:\\n\\n${context}\\n\\nQuestion: ${originalQuery}` }\n  ]\n};\n\nreturn { json: { requestBody, originalQuery } };"
      },
      "id": "nb12-build-prompt",
      "name": "Build LLM Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "nb13-llm",
      "name": "LLM Synthesis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2460,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const llmResponse = $input.item.json;\nconst answer = llmResponse.message?.content || llmResponse.response || 'Unable to generate a response.';\nreturn { json: { response: answer } };"
      },
      "id": "nb14-extract",
      "name": "Extract Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2680,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ response: $json.response }) }}"
      },
      "id": "nb15-final-response",
      "name": "Final Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2900,
        300
      ]
    }
  ],
