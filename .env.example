# Copy to .env to override defaults (optional - everything works without it).

# n8n image tag. Workflows were built and tested against 2.47.7.
N8N_VERSION=latest

# Encrypts credentials stored inside n8n. Change it for anything non-local.
N8N_ENCRYPTION_KEY=genx-local-dev-encryption-key-change-me

# Postgres (pgvector) - also used by the auto-imported n8n credential
POSTGRES_USER=genx
POSTGRES_PASSWORD=genx_local_pw
POSTGRES_DB=genx_rag
POSTGRES_HOST_PORT=5433

# Ollama running on your host machine (default) ...
OLLAMA_BASE_URL=http://host.docker.internal:11434
# ... or inside compose: `docker compose --profile ollama up -d` and set
# OLLAMA_BASE_URL=http://ollama:11434

LLM_MODEL=llama3.2
EMBED_MODEL=bge-m3
